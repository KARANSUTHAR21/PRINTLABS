# ==========================================================================
# PrintHub — environment template. Copy to `.env` and fill in the values.
#   cp .env.example .env
# Every empty value falls back to a safe built-in default (sandbox provider,
# console-logged emails, embedded PGLite) so the app runs with no keys at all.
# Precedence: real environment variables always beat values from `.env`.
# ==========================================================================

# --------------------------------------------------------------------------
# App
# --------------------------------------------------------------------------
FLASK_ENV=development
NODE_ENV=development

# --------------------------------------------------------------------------
# Core security — generate before any real deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# --------------------------------------------------------------------------
SECRET_KEY=
BETTER_AUTH_SECRET=
# Public origin of the app (used for auth callbacks + password-reset links).
BETTER_AUTH_URL=
FRONTEND_URL=http://localhost:8080

# --------------------------------------------------------------------------
# Database — empty = embedded PGLite (no setup). Set for real Postgres.
# --------------------------------------------------------------------------
DATABASE_URL=

# --------------------------------------------------------------------------
# Razorpay (test/sandbox keys from https://dashboard.razorpay.com → Settings →
# API Keys). Empty = built-in signed sandbox provider (no real money).
#   RAZORPAY_KEY_ID          starts with rzp_test_ for test mode
#   RAZORPAY_KEY_SECRET      the paired secret
#   RAZORPAY_WEBHOOK_SECRET  the webhook secret from Dashboard → Webhooks
# --------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --------------------------------------------------------------------------
# Email (SMTP) — empty = reset links are logged to the server console.
# --------------------------------------------------------------------------
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --------------------------------------------------------------------------
# OAuth / federated sign-in (injected automatically when deployed).
# --------------------------------------------------------------------------
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# --------------------------------------------------------------------------
# Frontend build flags (only VITE_ vars reach the browser).
# --------------------------------------------------------------------------
VITE_AUTH_ENABLED=true
