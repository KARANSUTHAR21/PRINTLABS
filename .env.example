# ==========================================================================
# PrintHub — environment template. Copy to `.env` and fill in the values.
#   cp .env.example .env
# Every empty value falls back to a safe built-in default (sandbox provider,
# console-logged emails, embedded PGLite) so the app runs with no keys at all.
# Precedence: real environment variables always beat values from `.env`.
# ==========================================================================

# --------------------------------------------------------------------------
# App
# --------------------------------------------------------------------------
# --------------------------------------------------------------------------
# Core security — generate before any real deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# --------------------------------------------------------------------------
SECRET_KEY=
BETTER_AUTH_SECRET=
# Public origin of the app (used for auth callbacks + password-reset links).
BETTER_AUTH_URL=
FRONTEND_URL=http://localhost:8080

# --------------------------------------------------------------------------
# Database — Supabase Postgres (or any Postgres). Empty = local embedded PGLite.
#
# Supabase: Project Settings → Database → Connection string → use the
# SESSION POOLER URI (port 5432, "Transaction" pooler NOT recommended — the
# app uses session-level advisory locks that need a real session). Migrations
# in migrations/*.sql apply automatically on first boot.
#
# Local dev without a value uses IN-MEMORY PGLite: every dev-server restart
# resets the database. The documented test account is re-seeded on boot:
#   razor.tester+1@example.com / Passw0rd!23
# To keep data across restarts instead, set PGLITE_DATA_DIR (e.g. .pglite-data).
# --------------------------------------------------------------------------
DATABASE_URL=
PGLITE_DATA_DIR=

# --------------------------------------------------------------------------
# Dev seed (PGLite only — never touches a real Postgres).
#   DEV_SEED_ADMIN=1     also create the admin account on boot
#   DEV_SEED_ADMIN_EMAIL its email (default admin.tester@example.com)
# --------------------------------------------------------------------------
DEV_SEED_ADMIN=
DEV_SEED_ADMIN_EMAIL=

# --------------------------------------------------------------------------
# Razorpay (test/sandbox keys from https://dashboard.razorpay.com → Settings →
# API Keys). Empty = built-in signed sandbox provider (no real money).
#   RAZORPAY_KEY_ID          starts with rzp_test_ for test mode; delivered to
#                            the browser by the server (payment-session response)
#                            — no VITE_ var is needed
#   RAZORPAY_KEY_SECRET      the paired secret (server-only, never exposed)
#   RAZORPAY_WEBHOOK_SECRET  Dashboard → Webhooks → endpoint POST /api/payments/webhook
#                            Required for webhook-driven payment recovery
# --------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --------------------------------------------------------------------------
# Email — Brevo.
#   BREVO_API_KEY  preferred transport (SMTP → API v3, no port negotiation).
#                  Brevo → SMTP & API → API Keys → Generate a new API key (v3).
#   MAIL_SERVER    fallback transport: Brevo SMTP relay smtp-relay.brevo.com:587
#   MAIL_USER      the relay login shown in Brevo (e.g. 92xxxxx@smtp-brevo.com)
#   MAIL_PASSWORD  your Brevo SMTP key
#   MAIL_FROM      must be a sender verified in Brevo (Senders & IP)
# --------------------------------------------------------------------------
BREVO_API_KEY=
MAIL_SERVER=
MAIL_PORT=587
MAIL_SECURE=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# --------------------------------------------------------------------------
# OAuth / federated sign-in.
# GROK_AUTH_*     shared broker client (injected when deployed) — brokers
#                 upstream sign-in (X, and Google when GOOGLE_CLIENT_* unset).
# GOOGLE_CLIENT_* the app's OWN Google Cloud OAuth client. When set, the
#                 Google button goes DIRECTLY to Google and the consent screen
#                 shows this app (not the broker's upstream, e.g. xAI).
#                 Add the redirect URI in Google Cloud Console → Credentials:
#                   http://localhost:8080/api/auth/callback/google
#                   http://127.0.0.1:8080/api/auth/callback/google
# --------------------------------------------------------------------------
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------------------------------------------------------------------
# Frontend build flags (only VITE_ vars reach the browser).
# --------------------------------------------------------------------------
VITE_AUTH_ENABLED=true
